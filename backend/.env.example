# ECDAT environment template. Copy to `.env` and adjust.
DJANGO_SECRET_KEY=change_me_to_a_long_random_string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ECDAT_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Require an API key (X-API-Key header) for every /api/ route except health.
# Empty = fall back to automatically enabling when DJANGO_DEBUG=0 (production)
# and disabling in development. Explicitly '1' or '0' to override.
ECDAT_REQUIRE_API_KEY=

# Optional PostgreSQL (also requires enabling in config/settings.py + psycopg2)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecdat
# DB_USER=ecdat
# DB_PASSWORD=change_me
# DB_HOST=127.0.0.1
# DB_PORT=5432
