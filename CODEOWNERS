backend/segments/ml/          @ecdat-team/ml
backend/segments/mitigation/  @ecdat-team/mitigation
backend/segments/reporting/   @ecdat-team/reporting

backend/core/                 @ecdat-team/platform @ecdat-team/shipit
backend/config/               @ecdat-team/platform
backend/schema/               @ecdat-team/platform @ecdat-team/shipit
backend/scripts/              @ecdat-team/platform
backend/docs/architecture/    @ecdat-team/platform @ecdat-team/shipit
backend/docs/api/             @ecdat-team/platform @ecdat-team/shipit

/CODEOWNERS                   @ecdat-team/platform